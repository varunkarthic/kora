#pragma once
/// @file version.hpp
/// KORA version information. Generated by CMake from VERSION (MAJOR.MINOR) and KORA_VERSION_PATCH.
#include <string>

#define KORA_VERSION_MAJOR @KORA_VERSION_MAJOR@
#define KORA_VERSION_MINOR @KORA_VERSION_MINOR@
#define KORA_VERSION_PATCH @KORA_VERSION_PATCH@

namespace kora {

/// Returns "major.minor.patch".
std::string version_string();

/// Schema version for persisted data (calibration, performance DB, tuning, pipeline cache).
/// Bump whenever a persisted format changes incompatibly; stale files are then discarded.
inline constexpr int kSchemaVersion = 1;

}  // namespace kora
