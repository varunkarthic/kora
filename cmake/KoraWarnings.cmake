# kora_configure_target(<target>): warnings + sanitizers for KORA-owned targets.
function(kora_configure_target tgt)
  if(MSVC)
    target_compile_options(${tgt} PRIVATE /W4 /permissive- /utf-8)
    return()
  endif()
  target_compile_options(${tgt} PRIVATE -Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wno-sign-conversion)
  set(_san "")
  if(KORA_SANITIZE_ADDRESS)
    list(APPEND _san address)
  endif()
  if(KORA_SANITIZE_UNDEFINED)
    list(APPEND _san undefined)
  endif()
  if(KORA_SANITIZE_THREAD)
    list(APPEND _san thread)
  endif()
  if(_san)
    list(JOIN _san "," _s)
    target_compile_options(${tgt} PRIVATE -fsanitize=${_s} -fno-omit-frame-pointer)
    target_link_options(${tgt} PRIVATE -fsanitize=${_s})
  endif()
endfunction()
