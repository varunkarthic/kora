#version 450

layout(local_size_x = 8, local_size_y = 2, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Data {
    uint values[];
} data_buffer;

layout(set = 0, binding = 1, std430) buffer SecondData {
    uint values[];
} second_buffer;

layout(push_constant) uniform Parameters {
    uint count;
} parameters;

layout(constant_id = 7) const uint SCALE = 2;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index < parameters.count) {
        data_buffer.values[index] *= SCALE;
        second_buffer.values[index] += SCALE;
    }
}
