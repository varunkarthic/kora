#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputValues { uint values[]; } input_values;
layout(set = 0, binding = 1, std430) writeonly buffer OutputValues { uint values[]; } output_values;

layout(push_constant) uniform Parameters {
    uint count;
    uint iterations;
    uint mode;
    uint seed;
} parameters;

void main() {
    const uint index = gl_GlobalInvocationID.x;
    if (index >= parameters.count) return;

    uint value = input_values.values[index];
    if (parameters.mode == 0) {
        value ^= parameters.seed;
    } else if (parameters.mode == 2) {
        for (uint iteration = 0; iteration < parameters.iterations; ++iteration) {
            value = value * 1664525u + 1013904223u;
            value ^= value >> 13u;
        }
    }
    output_values.values[index] = value;
}
